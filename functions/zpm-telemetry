#!/usr/bin/env zsh

autoload -Uz \
  @zpm-get-plugin-basename                \
  @zpm-get-plugin-documentation-hyperlink \
  @zpm-get-plugin-documentation-link      \
  @zpm-get-plugin-name                    \
  @zpm-get-plugin-origin                  \
  @zpm-get-plugin-origin-type             \
  @zpm-get-plugin-path                    \
  @zpm-get-plugin-type

function _zpm__telemetry_urlencode() (
  LC_ALL=C
  local str="$1"
  while [[ -n "$str" ]]; do
    local safe="${str%%[!a-zA-Z0-9/:_\.\-\!\'\(\)~]*}"
    printf "%s" "$safe"
    str="${str#"$safe"}"
    if [[ -n "$str" ]]; then
      printf "%%%02X" "'$str"
      str="${str#?}"
    fi
  done
)

local telemetry=''

# OS detection
local os_version
if (( $+commands[lsb_release] )); then
  os_version=$(lsb_release -si -ri -ci 2>/dev/null)
elif [[ -f /etc/os-release ]]; then
  os_version="$(grep -E '^PRETTY_NAME=' /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '\"')"
fi
[[ -z "$os_version" ]] && os_version="$(uname -srm)"

local zsh_ver="${ZSH_VERSION:-$(zsh --version 2>/dev/null)}"

local git_branch="" git_commit=""
if [[ -d "${_ZPM_DIR}/.git" ]]; then
  git_branch=$(git --git-dir="${_ZPM_DIR}/.git/" --work-tree="${_ZPM_DIR}/" symbolic-ref --short HEAD 2>/dev/null || echo "main")
  git_commit=$(git --git-dir="${_ZPM_DIR}/.git/" --work-tree="${_ZPM_DIR}/" rev-parse --short HEAD 2>/dev/null)
fi

telemetry+="
## OS Info

|Info|Value|
|---|---|
|OS|${os_version}|
|zsh version|${zsh_ver}|

"

telemetry+="
## ZPM Info

|Info|Value|
|---|---|
|Git branch|[${git_branch}](https://github.com/zpm-zsh/zpm/tree/${git_branch})|
|Git commit|[${git_commit}](https://github.com/zpm-zsh/zpm/commit/${git_commit})|

"

telemetry+="
## Plugins

|Name|Type|Async|Options|
|:--|:--|:--|:--|
"

for key in ${(k)_ZPM_plugins_full}; do
  local spec="${_ZPM_plugins_full[$key]}"
  local Plugin_name="$(@zpm-get-plugin-name "$spec")"
  local Plugin_type="$(@zpm-get-plugin-type "$Plugin_name")"
  local Plugin_basename="$(@zpm-get-plugin-basename "$Plugin_name")"
  local Plugin_origin_type="$(@zpm-get-plugin-origin-type "$Plugin_name")"
  local Plugin_origin="$(@zpm-get-plugin-origin "$spec" "$Plugin_name" "$Plugin_basename" "$Plugin_type" "$Plugin_origin_type")"
  local Plugin_link="$(@zpm-get-plugin-documentation-link "$Plugin_name" "$Plugin_type" "$Plugin_origin")"

  local Plugin_async="false"
  [[ "$spec" == *",async"* ]] && Plugin_async="true"

  local Plugin_option=""
  if [[ "$spec" == *,* ]]; then
    Plugin_option="${spec#*,}"
    Plugin_option="${Plugin_option//,async/}"
    Plugin_option="${Plugin_option//async,/}"
    Plugin_option="${Plugin_option//async/}"
  fi

  telemetry+="|[${Plugin_name}](${Plugin_link})|${Plugin_type}|${Plugin_async}|${Plugin_option}|
"
done

telemetry+='
> Telemetry data generated with [zpm-telemetry](https://github.com/zpm-zsh/zpm-telemetry) for [zpm](https://github.com/zpm-zsh/zpm) 😊
'

local telemetry_body_urlencoded=$(_zpm__telemetry_urlencode "$telemetry")
local telemetry_title_urlencoded=$(_zpm__telemetry_urlencode "ZPM telemetry report")
local telemetry_label_urlencoded=$(_zpm__telemetry_urlencode "telemetry")

local target_url="https://github.com/zpm-zsh/zpm-telemetry/issues/new?body=${telemetry_body_urlencoded}&title=${telemetry_title_urlencoded}&labels=${telemetry_label_urlencoded}"

if (( $+commands[xdg-open] )); then
  xdg-open "$target_url" 2>/dev/null
elif (( $+commands[open] )); then
  open "$target_url" 2>/dev/null
else
  print "Telemetry URL:"
  print "$target_url"
fi
